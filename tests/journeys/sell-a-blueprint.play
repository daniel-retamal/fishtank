# JOURNEY · sell a design by name: capture a clock, let the ghost offer the kind, TAB to the blueprint's name, sell it.
# A named thing is sold with its kind (/sell fish|tank|blueprint), so a fish and a design that share a name never collide.

clear
include scenes/start-with-a-stake.play
include scenes/grow-a-matrixtank.play
include scenes/buy-at-the-bench.play "Inverter Coil" Fabric
include scenes/buy-at-the-bench.play "Blank Circuit Blueprint" Materials
include scenes/buy-a-fish.play Botfish osc
run /consume inverter coil
key enter
run /program "Osc"
type ring
key down
type ring
key enter
absent listens

run /consume blank circuit blueprint
type clock
key enter
absent Name your
run /foundry
expect Clock
key esc

type /sell blue
expect print <name>
snap the ghost offers the kind before the name
key tab
type "cl
expect ock"
snap the ghost finishes the blueprint's name
key tab
key enter

run /foundry
absent ─ Foundry
snap the blueprint is gone, so the Foundry has nothing to open
