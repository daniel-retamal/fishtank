# JOURNEY · death: a sold fish opens no heaven; the Pearl of Great Price grows the Heaventank, and the
# dead who were waiting hang on its wall. A pearl is FOUND, never bought, and a journey cannot fish on
# cue, so it is handed over in debug mode, which is switched straight back off.

clear
include scenes/start-with-a-stake.play
include scenes/buy-a-fish.play Merluza Ann
run /sell fish "Ann"
run /fishtanks
absent Heaventank
snap no heaven opens on its own
key esc

run !debugmode
run /give pearl of great price
run !debugmode
run /consume pearl of great price
expect Name your
snap the pearl names the tank it grows
type Heaventank
key enter
absent Name your

run /names
tick 20
snap the dead drift behind the clouds and the gate
run /names

run /index "Heaventank"
expect Ann
expect Dead
snap the heaven index lists the dead
key esc

run /switch "Fishtank"
run /index
absent Dead
